# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น git)
# cp .env.example .env.local
#
# หมายเหตุ: ถ้าค่ามีเครื่องหมาย $ ต้อง escape เป็น \$ ไม่งั้น Next (dotenv-expand)
# จะตีความว่าเป็นชื่อตัวแปรแล้วตัดส่วนนั้นทิ้ง ทำให้ค่าที่โหลดเข้าโปรแกรมไม่ตรงกับที่กรอก

# --- Track123 (รวม API ติดตามพัสดุหลายขนส่ง) ---
TRACK123_API_KEY=

# --- ไปรษณีย์ไทย (Thailand Post Track & Trace) ---
THAILAND_POST_API_KEY=

# --- Supabase (ระบบสมาชิก / เข้าสู่ระบบด้วย Google) ---
# หาได้ที่ Supabase Dashboard → Project Settings → API
#
# ทั้งสองค่ามี prefix NEXT_PUBLIC_ เพราะต้องถูกฝังลงใน bundle ฝั่ง browser
# ซึ่งเป็นวิธีใช้งานปกติของ anon key — มันเป็นคีย์สาธารณะโดยการออกแบบ
# สิทธิ์การเข้าถึงข้อมูลจริงถูกคุมด้วย Row Level Security ที่ฝั่ง Supabase
# (คนละตัวกับ service_role key ซึ่งห้ามใส่ prefix NEXT_PUBLIC_ เด็ดขาด)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ค่าทั่วไปของแอป ---
# URL หลักของเว็บ ใช้สำหรับสร้างลิงก์แบบเต็ม
NEXT_PUBLIC_SITE_URL=http://localhost:3000
