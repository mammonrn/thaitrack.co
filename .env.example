# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น git)
# cp .env.example .env.local
#
# หมายเหตุ: ถ้าค่ามีเครื่องหมาย $ ต้อง escape เป็น \$ ไม่งั้น Next (dotenv-expand)
# จะตีความว่าเป็นชื่อตัวแปรแล้วตัดส่วนนั้นทิ้ง ทำให้ค่าที่โหลดเข้าโปรแกรมไม่ตรงกับที่กรอก

# --- Track123 (รวม API ติดตามพัสดุหลายขนส่ง) ---
TRACK123_API_KEY=

# --- ไปรษณีย์ไทย (Thailand Post Track & Trace) ---
THAILAND_POST_API_KEY=

# --- Supabase (ระบบสมาชิก เข้าสู่ระบบด้วย Google) ---
# หาได้จาก Supabase dashboard → Project Settings → API
#
# สำคัญ: ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงไฟล์ JS ตอน `next build`
# ไม่ได้อ่านตอน runtime ถ้าเพิ่มหรือแก้ค่าเหล่านี้ ต้อง build ใหม่เสมอ
# (บน Vercel คือต้อง redeploy ไม่ใช่แค่กด restart)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — ใช้เขียน/อ่านตาราง cache ผลติดตามพัสดุ (public.tracking_cache)
# หาได้จาก Supabase dashboard → Project Settings → API → service_role
#
# ⚠️ key ตัวนี้ข้าม Row Level Security ได้ทุกตาราง เทียบเท่ารหัสผ่านของฐานข้อมูล
# ทั้งก้อน ห้ามเปลี่ยนชื่อให้ขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด เพราะ Next จะฝังค่า
# ที่ขึ้นต้นแบบนั้นลงไฟล์ JS ที่ส่งให้เบราว์เซอร์ ใครเปิดเว็บก็ได้ key ไปทันที
#
# ถ้าไม่ตั้งค่านี้ ระบบยังทำงานได้ตามปกติ เพียงแต่ cache จะอยู่ใน memory อย่างเดียว
# (หายทุกครั้งที่ deploy/restart และไม่มีข้อมูลสำรองไว้แสดงตอนระบบขนส่งล่ม)
#
# ต้องรัน supabase/migrations/0003_tracking_cache.sql ก่อนใช้งาน
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ---
# ใช้แปลงข้อความสถานที่จากขนส่ง (เช่น "สำเหร่ 10600") เป็นพิกัด ตอนกดบันทึกประวัติ
# ตัวนี้ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด เพราะต้องอยู่ฝั่ง server เท่านั้น
# เปิดใช้ Geocoding API ใน Google Cloud Console
GOOGLE_MAPS_API_KEY=

# คีย์สำหรับ Maps Embed API ที่ใช้แสดงแผนที่ในหน้าประวัติ
#
# ต้องเป็นคนละตัวกับ GOOGLE_MAPS_API_KEY ข้างบน เพราะ Embed API ต้องใส่คีย์ลงใน
# URL ของ iframe ซึ่งผู้ใช้เปิดดู source เห็นได้เสมอ ถ้าใช้ตัวเดียวกันคีย์ที่ตั้งใจ
# ซ่อนไว้ฝั่ง server จะหลุดออกไปทันที
#
# ให้สร้างคีย์ใหม่ เปิดเฉพาะ Maps Embed API แล้วตั้ง HTTP referrer restriction
# ให้ใช้ได้เฉพาะโดเมนของเรา ถ้าไม่ตั้งค่าไว้ หน้าประวัติจะไม่แสดงแผนที่ (ไม่ error)
GOOGLE_MAPS_EMBED_KEY=

# --- ค่าทั่วไปของแอป ---
# URL หลักของเว็บ ใช้สำหรับสร้างลิงก์แบบเต็ม
NEXT_PUBLIC_SITE_URL=http://localhost:3000
