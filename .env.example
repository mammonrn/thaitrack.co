# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น git)
# cp .env.example .env.local
#
# หมายเหตุ: ถ้าค่ามีเครื่องหมาย $ ต้อง escape เป็น \$ ไม่งั้น Next (dotenv-expand)
# จะตีความว่าเป็นชื่อตัวแปรแล้วตัดส่วนนั้นทิ้ง ทำให้ค่าที่โหลดเข้าโปรแกรมไม่ตรงกับที่กรอก

# --- Track123 (รวม API ติดตามพัสดุหลายขนส่ง) ---
TRACK123_API_KEY=

# --- ไปรษณีย์ไทย (Thailand Post Track & Trace) ---
THAILAND_POST_API_KEY=

# --- ETrackings (ใช้สลับกับ Track123 ตามความถนัด) ---
# https://apps.etrackings.com/docs/api-reference
#
# ระบบเลือกเจ้านี้ก่อนเมื่อ prefix ของเลขฟันธงขนส่งได้ (เช่น SPXTH → Shopee
# Xpress) เพราะเป็นเจ้าเดียวที่คืนข้อความไทยล้วนและที่อยู่เต็มของสาขา ซึ่งเป็น
# วัตถุดิบของการเติมพิกัดสาขาอัตโนมัติ ส่วนเลขที่เดาขนส่งไม่ออกใช้ Track123
# เพราะเจ้านี้บังคับให้ระบุขนส่งเอง ตรวจจับให้ไม่ได้
#
# ทั้งสองตัวเป็นความลับ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
# ถ้าไม่ตั้งค่า ระบบทำงานได้ครบทุกอย่างด้วย Track123 เจ้าเดียว ยกเว้นการเติม
# พิกัดสาขาอัตโนมัติ
ETRACKINGS_API_KEY=
ETRACKINGS_KEY_SECRET=

# --- เพดานโควตาต่อเดือนของแต่ละเจ้า (ไม่บังคับ) ---
# ระบบนับจำนวน request ที่ยิงออกไปจริงของแต่ละเจ้า เก็บลงตาราง provider_usage
# แล้วเอียงไปใช้อีกเจ้าเมื่อเจ้าที่ควรได้ไปก่อนใช้ไปถึงสัดส่วนที่ตั้งไว้
#
# ⚠️ ควรตั้งให้ตรงกับแผนที่จ่ายจริง ค่าเริ่มต้นเป็นการเดาแบบระมัดระวัง
# (Track123 1000 · ETrackings 50 ซึ่งเป็นเพดานของแผนฟรี)
#
# ⚠️ ตัวเลขที่นับเป็น "จำนวน request" ไม่ใช่ "จำนวนเลขพัสดุ" — Track123 คิดเงิน
# เป็นรายเลขพัสดุต่อรอบบิล ยอดที่เห็นในหน้าสถิติจึงสูงกว่ายอดบิลเสมอ
TRACK123_MONTHLY_CALL_LIMIT=
ETRACKINGS_MONTHLY_CALL_LIMIT=

# ใช้ไปกี่ส่วนของเพดานแล้วถือว่า "ใกล้เต็ม" (0–1) ค่าเริ่มต้น 0.8
PROVIDER_QUOTA_LEAN_RATIO=

# --- การเติมพิกัดสาขาอัตโนมัติ (ไม่บังคับ) ---
# เมื่อเจอรหัสสาขาที่ยังไม่รู้พิกัด ระบบจะยิง ETrackings หนึ่งครั้งเพื่อขอที่อยู่
# ของสาขานั้นมาแปลงเป็นพิกัด แล้วเก็บลง carrier_branches ให้ใช้ได้ตลอดไป
#
# กันเผาโควตาด้วยสี่ด่าน: prefix ต้องฟันธงได้ · โควตาต้องไม่ใกล้เต็ม ·
# งบต่อวันของโปรเซส · และการจองสิทธิ์ต่อสาขาในฐานข้อมูล (atomic)
#
# ค่าเริ่มต้น: 10 ครั้ง/วัน และถามสาขาเดิมซ้ำได้เมื่อพ้น 168 ชั่วโมง (7 วัน)
BRANCH_PROBE_DAILY_LIMIT=
BRANCH_PROBE_COOLDOWN_HOURS=

# --- Supabase (ระบบสมาชิก เข้าสู่ระบบด้วย Google) ---
# หาได้จาก Supabase dashboard → Project Settings → API
#
# สำคัญ: ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงไฟล์ JS ตอน `next build`
# ไม่ได้อ่านตอน runtime ถ้าเพิ่มหรือแก้ค่าเหล่านี้ ต้อง build ใหม่เสมอ
# (บน Vercel คือต้อง redeploy ไม่ใช่แค่กด restart)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — ใช้เขียน/อ่านตาราง cache ผลติดตามพัสดุ (public.tracking_cache)
# หาได้จาก Supabase dashboard → Project Settings → API → service_role
#
# ⚠️ key ตัวนี้ข้าม Row Level Security ได้ทุกตาราง เทียบเท่ารหัสผ่านของฐานข้อมูล
# ทั้งก้อน ห้ามเปลี่ยนชื่อให้ขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด เพราะ Next จะฝังค่า
# ที่ขึ้นต้นแบบนั้นลงไฟล์ JS ที่ส่งให้เบราว์เซอร์ ใครเปิดเว็บก็ได้ key ไปทันที
#
# ถ้าไม่ตั้งค่านี้ ระบบยังทำงานได้ตามปกติ เพียงแต่ cache จะอยู่ใน memory อย่างเดียว
# (หายทุกครั้งที่ deploy/restart และไม่มีข้อมูลสำรองไว้แสดงตอนระบบขนส่งล่ม)
#
# ต้องรัน supabase/migrations/0003_tracking_cache.sql ก่อนใช้งาน
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps ---
# ใช้แปลงข้อความสถานที่จากขนส่ง (เช่น "สำเหร่ 10600") เป็นพิกัด ตอนกดบันทึกประวัติ
# ตัวนี้ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด เพราะต้องอยู่ฝั่ง server เท่านั้น
# เปิดใช้ Geocoding API ใน Google Cloud Console
GOOGLE_MAPS_API_KEY=

# ⚠️ GOOGLE_MAPS_EMBED_KEY ไม่ใช้แล้ว — ลบออกจาก .env.local ได้เลย
#
# หน้าประวัติเปลี่ยนจาก Maps Embed API (iframe โต้ตอบได้ ต้องใส่คีย์ลงใน URL
# ที่ผู้ใช้เปิดดู source เห็น) มาเป็นภาพนิ่งจาก Maps Static API ที่ยิงผ่าน
# /api/map ของเราเอง คีย์จึงไม่เคยออกจากเครื่อง ใช้ GOOGLE_MAPS_API_KEY
# ข้างบนได้เลย
#
# ต้องเปิด "Maps Static API" ให้คีย์ตัวนั้นใน Google Cloud Console เพิ่มด้วย
# (คนละตัวกับ Geocoding API ที่เปิดไว้แล้ว)

# --- เกณฑ์ความละเอียดของพิกัด (ไม่บังคับ) ---
# พิกัดที่ "รัศมีความคลาดเคลื่อน" กว้างกว่าค่านี้จะไม่ถูกปักหมุดเลย เพราะมันคือ
# หมุดกลางอำเภอ/จังหวัด ซึ่งห่างจากที่จริงได้เป็นสิบกิโล
#
# ค่าเริ่มต้น 5000 (5 กม. = ระดับตำบล/หมู่บ้าน) พิกัดที่กว้างกว่า 150 ม. แต่ยัง
# ไม่เกินค่านี้ ยังปักหมุดให้ แต่ขึ้นป้าย "ตำแหน่งโดยประมาณ" และซูมออกให้
#
# รัศมีวัดจาก geometry.viewport ที่ Google คืนมา ไม่ใช่ location_type
# (เคยใช้ location_type แล้วพัง — ที่อยู่ไทยไม่เคยได้ ROOFTOP เลย)
#
# ปรับค่านี้มีผลกับพิกัดที่ cache ไว้แล้วทันที ไม่ต้องล้าง cache
# ⚠️ ด่านที่ปฏิเสธ "เขตปกครองระดับอำเภอขึ้นไป" ไม่เปิดให้ปรับ ไม่ว่าเพดานจะกว้าง
# แค่ไหน จุดกึ่งกลางของอำเภอก็ไม่ใช่ที่ตั้งของอะไรทั้งนั้น
GEOCODE_MAX_ACCURACY_METERS=

# --- หน้าแอดมิน ---
# อีเมลที่เข้าหน้า /admin/branches และเรียก /api/admin/* ได้ คั่นด้วยคอมมา
# เช่น ADMIN_EMAILS=you@gmail.com,teammate@gmail.com
#
# ⚠️ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เพราะจะถูกฝังลงไฟล์ JS ที่ส่งให้เบราว์เซอร์
# ถ้าไม่ตั้งค่านี้ จะไม่มีใครเข้าหน้าแอดมินได้เลย (ปฏิเสธทุกคน ไม่ใช่เปิดให้ทุกคน)
# ต้องรัน migration 0004 ถึง 0007 ก่อนใช้งาน (ดูลำดับใน README)
#
# หน้าที่ใช้ได้: /admin/branches (กรอกพิกัดสาขา) และ /admin/stats (สถิติรวม)
# ⚠️ หน้าสถิติแสดงตัวเลขรวมเท่านั้น ไม่มีทางดูได้ว่าผู้ใช้คนไหนค้นพัสดุอะไร
ADMIN_EMAILS=

# --- ค่าทั่วไปของแอป ---
# URL หลักของเว็บ ใช้สำหรับสร้างลิงก์แบบเต็ม
NEXT_PUBLIC_SITE_URL=http://localhost:3000
